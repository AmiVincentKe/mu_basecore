#string STR_MODULE_ABSTRACT             #language en-US "Lz4CompressLib produces LZ4 block compression algorithm"

#string STR_MODULE_DESCRIPTION          #language en-US "Wraps an LZ4 block encoder into a UEFI-compatible BASE library. The hash table is allocated with AllocatePages for safe use in PEI and DXE environments."
